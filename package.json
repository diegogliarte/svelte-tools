{
	"name": "svelte-tools",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"scrape:inazuma-vr:players": "tsx src/scripts/inazuma-eleven-vr/players.ts",
		"scrape:inazuma-vr:hissatsu-movies": "tsx src/scripts/inazuma-eleven-vr/hissatsu-movies.ts",
		"scrape:digimon-story-ts:digimons": "tsx src/scripts/digimon-story-ts/digimons.ts",
		"scrape:digimon-story-ts:download-icons": "tsx src/scripts/digimon-story-ts/download-icons.ts",
		"scrape:pmd-blue:download-icons": "tsx src/scripts/pmd-blue/download-icons.ts",
		"scrape:pokemon-main-series": "tsx src/scripts/pokemon-main-series/data.ts && tsx src/scripts/pokemon-main-series/normalize-sprites.ts --write",
		"check:pokemon-main-series:sprites": "tsx src/scripts/pokemon-main-series/normalize-sprites.ts",
		"normalize:pokemon-main-series:sprites": "tsx src/scripts/pokemon-main-series/normalize-sprites.ts --write",
		"scrape:yokai-watch-2:baffle-boards": "tsx src/scripts/yokai-watch-2/baffle-boards.ts",
		"scrape:osrs:slayer-tasks": "tsx src/scripts/osrs/slayer-tasks.ts",
		"generate:emojis": "tsx src/scripts/emojis/generate.ts",
		"generate-og-images": "tsx src/scripts/generate-og-images.ts"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md,css,html,yml,yaml}": "prettier --write"
	},
	"dependencies": {
		"@netlify/blobs": "^10.7.11",
		"chart.js": "^4.5.1",
		"crypto-js": "^4.2.0",
		"jsqr": "^1.4.0",
		"jszip": "^3.10.1",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^9.39.1",
		"@iconify-json/mdi": "^1.2.3",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.1.17",
		"@types/crypto-js": "^4.2.2",
		"@types/node": "^22",
		"@types/qrcode": "^1.5.6",
		"cheerio": "^1.2.0",
		"csv-parse": "^6.1.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.8.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.1.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"overrides": {
			"cookie": "^0.7.0",
			"undici": "7.28.0"
		}
	},
	"packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
